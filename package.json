{
  "name": "lms-cli",
  "version": "0.4.7",
  "description": "Multi-school Canvas / Blackboard CLI and Agent tools with read-only MCP and local sign-in",
  "type": "module",
  "license": "MIT",
  "author": "LMS CLI contributors",
  "homepage": "https://github.com/zs-andy/lms-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zs-andy/lms-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zs-andy/lms-cli/issues"
  },
  "keywords": [
    "lms",
    "canvas",
    "blackboard",
    "education",
    "mcp",
    "multi-school"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "lms": "bin/lms.js"
  },
  "main": "dist/src/auth/app.js",
  "files": [
    "bin",
    "dist",
    "plugins/lms-cli",
    "scripts/launchers",
    "docs",
    "vendor/*/LICENSE",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "start": "node bin/lms.js",
    "auth:app": "electron .",
    "pack:cli": "npm run build && npm pack",
    "pack:manifests": "node scripts/generate-package-manifests.mjs",
    "pack:standalone": "npm run build && node scripts/pack-standalone.mjs",
    "pack:app:release": "npm run build && node scripts/pack-macos-app.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:auth:background": "electron scripts/verify-background-auth.mjs",
    "verify:auth": "electron scripts/verify-login-preload.mjs && electron scripts/verify-adfs-preload.mjs && electron scripts/verify-auth-flow.mjs && electron scripts/verify-auth-ui.mjs",
    "pack:app": "npm run build && electron-builder --publish never",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "ajv": "8.20.0",
    "commander": "14.0.3",
    "ical-generator": "10.0.0",
    "proper-lockfile": "4.1.2",
    "tar": "7.5.23",
    "tough-cookie": "6.1.0",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "electron": "45.4.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.2",
    "@types/node": "24.5.2",
    "@types/proper-lockfile": "4.1.4",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "org.lmscli.authorization",
    "productName": "lms-cli",
    "icon": "assets/lms-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "vendor/*/LICENSE"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "assets/lms-icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/lms-icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "lms-cli-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/lms-icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
